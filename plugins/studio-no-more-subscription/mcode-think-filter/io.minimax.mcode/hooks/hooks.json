{
  "$schema": "https://minimax.io/schemas/mcode-hooks/0.1.0/hooks.schema.json",
  "hooks": {
    "PostToolUse": [
      {
        "command": "node",
        "args": [
          "${PLUGIN_ROOT}/io.minimax.mcode/hooks/scripts/trim-thinking.mjs",
          "--state",
          "${PLUGIN_DATA}/state.json"
        ],
        "matcher": "*",
        "timeout": 5000,
        "once": false
      }
    ],
    "PreCompact": [
      {
        "command": "node",
        "args": [
          "${PLUGIN_ROOT}/io.minimax.mcode/hooks/scripts/trim-thinking.mjs",
          "--state",
          "${PLUGIN_DATA}/state.json",
          "--phase",
          "pre-compact"
        ],
        "timeout": 5000,
        "once": false
      }
    ]
  }
}
