{
  "schema": "jianying.pipeline-profiles.v1",
  "note": "跨链路线的【机器可读】定义。★ 每一步的动词必须在 mcp/tools/*.schema.json 里，参数必须在该动词的 properties 里 ⇒ 由机械审计 7k 校验（拼错的动词/参数当场报出来）。★ $ 开头的是【变量】：$draft/$outDir/$grade 由调用者给，$sessionId/$dir 由前一步的返回带下来。",
  "variables": {
    "$draft": "调用者给的剪映草稿目录（真草稿，只读）",
    "$outDir": "调用者给的输出目录",
    "$grade": "调色 spec（形状同 grade_apply 的 spec；也可用 references/intent-map.json 里的映射）",
    "$sessionId": "draft_open 返回的 sessionId（ve-session-N）",
    "$dir": "draft_open 返回的副本目录（★ 草稿动词与出片动词之间的交接点）",
    "$segmentId": "draft_read 里读到的段 id",
    "$beforeDraft": "改前的裸草稿 JSON 路径（顶层有 tracks）",
    "$afterDraft": "改后的裸草稿 JSON 路径（顶层有 tracks）",
    "$srt": "用户提供的转写稿（SRT）★ 官方 ASR 拿不到，不能自己编",
    "$planPath": "★ 编排器分配的产物路径（在流水线工作目录里）⇒ 路线用 alloc 声明谁来分配",
    "$film": "★ 上一步产出的成片（相对 $outDir）⇒ 由步骤的 produces 声明",
    "$mixed": "★ 混音后的成片（相对 $outDir）⇒ 由步骤的 produces 声明",
    "$draftJson": "★ 这一版的裸草稿 JSON（由 draft_read 步骤写出）⇒ 单版审片用它看结构",
    "$reviewDir": "★ 审片帧目录的父目录（相对 $outDir）⇒ 由步骤的 produces 声明",
    "$noiseDir": "★ 噪声底帧目录的父目录（相对 $outDir）⇒ 同一状态再渲一次",
    "$draftAfter": "★ 第二份草稿（改后那一版）⇒ 两版对照审片用",
    "$sidBefore": "★ 改前那一版的会话 id（由 setVars 从 $sessionId 存下来）",
    "$dirBefore": "★ 改前那一版的副本目录",
    "$beforeDraftJson": "★ 改前那一版的裸草稿 JSON",
    "$sidAfter": "★ 改后那一版的会话 id",
    "$dirAfter": "★ 改后那一版的副本目录",
    "$afterDraftJson": "★ 改后那一版的裸草稿 JSON",
    "$beforeOut": "★ 改前那一版的成片输出目录",
    "$afterOut": "★ 改后那一版的成片输出目录",
    "$filmBefore": "★ 改前那一版的成片（相对 $outDir）",
    "$filmAfter": "★ 改后那一版的成片（相对 $outDir）"
  },
  "profiles": [
    {
      "id": "grade-and-render",
      "when": "调色并出成片（'把这个草稿调暖再出片'）",
      "requires": ["剪映在跑", "素材在盘上"],
      "steps": [
        {
          "verb": "draft_open",
          "args": { "draft": "$draft", "copy": true },
          "yields": ["$sessionId", "$dir"],
          "note": "开副本；copy 默认 true ⇒ 真草稿只读"
        },
        {
          "verb": "make_film",
          "args": { "draft": "$dir", "outDir": "$outDir", "grade": "$grade", "denoise": "auto" },
          "note": "官方渲染器出画面 + 我们的调色/混音 + ffmpeg 编码；★ 内建验收（双流/时长/响度）失败会直接判失败"
        }
      ]
    },
    {
      "id": "edit-and-verify",
      "when": "改草稿并用语义判据验收（'把这段音量调到 25%，改完确认一下'）",
      "requires": ["剪映在跑", "素材在盘上"],
      "steps": [
        { "verb": "draft_open", "args": { "draft": "$draft", "copy": true }, "yields": ["$sessionId", "$dir"] },
        { "verb": "draft_read", "args": { "sessionId": "$sessionId" }, "yields": ["$segmentId"] },
        {
          "verb": "draft_patch",
          "args": { "op": "video.setVolume", "sessionId": "$sessionId", "params": { "segmentId": "$segmentId", "volume": 0.25 } },
          "note": "可多次；每次 baseRevision 会递增"
        },
        {
          "verb": "draft_commit",
          "args": { "sessionId": "$sessionId", "realDraft": "$draft" },
          "note": "素材路径重定位 + 真草稿 sha 断言（真草稿被改动就判失败）"
        },
        {
          "verb": "verify_diff",
          "args": { "checks": ["timeline"], "beforeDraft": "$beforeDraft", "afterDraft": "$afterDraft", "expect": { "segmentFieldChanged": "volume" } },
          "note": "★ 主判据 = 语义（逐段字段差），完全确定；两份草稿必须是【裸草稿】"
        }
      ]
    },
    {
      "id": "edit-then-render",
      "when": "改完直接出片（'改完直接出个片'）= edit-and-verify 的前半 + grade-and-render 的出片",
      "requires": ["剪映在跑", "素材在盘上"],
      "steps": [
        { "verb": "draft_open", "args": { "draft": "$draft", "copy": true }, "yields": ["$sessionId", "$dir"] },
        { "verb": "draft_read", "args": { "sessionId": "$sessionId" }, "yields": ["$segmentId"] },
        {
          "verb": "draft_patch",
          "args": { "op": "video.setVolume", "sessionId": "$sessionId", "params": { "segmentId": "$segmentId", "volume": 0.25 } }
        },
        { "verb": "draft_commit", "args": { "sessionId": "$sessionId", "realDraft": "$draft" } },
        {
          "verb": "make_film",
          "args": { "draft": "$dir", "outDir": "$outDir", "grade": "$grade", "denoise": "auto" },
          "note": "★ draft 用同一个 $dir ⇒ 全程一份副本"
        }
      ]
    },
    {
      "id": "talk-cut-then-render",
      "when": "剪口播再出片（'把口播的废话剪了再出片'）",
      "requires": ["剪映在跑", "素材在盘上", "★ 用户提供 SRT（官方 ASR 拿不到，不能自己编）", "★ 保留区间表必须先给用户确认"],
      "alloc": { "$planPath": "talk-cut-plan.json" },
      "steps": [
        { "verb": "draft_open", "args": { "draft": "$draft", "copy": true }, "yields": ["$sessionId", "$dir"] },
        { "verb": "draft_read", "args": { "sessionId": "$sessionId" } },
        {
          "script": "talk-cut-plan.mjs",
          "args": { "--srt": "$srt", "--out": "$planPath" },
          "confirm": true,
          "artifact": "$planPath",
          "confirmNote": "★ 保留/删除区间表已经生成，但【还没落刀】—— 必须先给用户确认",
          "note": "产出保留/删除区间表 ⇒ confirm:true ⇒ 这一步跑完编排器会停下来等人确认（AWAIT_CONFIRM）"
        },
        {
          "script": "talk-cut-apply.mjs",
          "args": { "--plan": "$planPath", "--draft": "$draft", "--sessionId": "$sessionId", "--apply": true },
          "note": "★ --sessionId ⇒ 复用编排器开的会话（不自己开、不自己落盘）；--apply ⇒ 真剪"
        },
        { "verb": "draft_commit", "args": { "sessionId": "$sessionId", "realDraft": "$draft" } },
        { "verb": "make_film", "args": { "draft": "$dir", "outDir": "$outDir", "denoise": "auto" } }
      ]
    },
    {
      "id": "subtitle-then-render",
      "when": "加字幕并出片（'给这个视频加字幕再出片'）",
      "requires": ["剪映在跑", "素材在盘上", "★ 用户提供 SRT（官方 ASR 拿不到，不能自己编）"],
      "steps": [
        { "verb": "draft_open", "args": { "draft": "$draft", "copy": true }, "yields": ["$sessionId", "$dir"] },
        { "verb": "draft_read", "args": { "sessionId": "$sessionId" } },
        {
          "script": "add-subtitles.mjs",
          "args": { "--srt": "$srt", "--sessionId": "$sessionId", "--apply": true },
          "note": "★ --sessionId ⇒ 复用编排器开的会话（不自己开、不自己落盘）；--apply ⇒ 真落字幕"
        },
        { "verb": "draft_commit", "args": { "sessionId": "$sessionId", "realDraft": "$draft" } },
        { "verb": "make_film", "args": { "draft": "$dir", "outDir": "$outDir", "denoise": "auto" } }
      ]
    },
    {
      "id": "render-and-mix",
      "when": "出片并按草稿重做混音（'出片时把混音按草稿重做一遍'）",
      "requires": ["剪映在跑", "★ 草稿里要有音频轨（没有音轨就只剩画面）"],
      "steps": [
        { "verb": "draft_open", "args": { "draft": "$draft", "copy": true }, "yields": ["$sessionId", "$dir"] },
        {
          "verb": "make_film",
          "args": { "draft": "$dir", "outDir": "$outDir", "denoise": "auto" },
          "produces": { "$film": "film.mp4", "$mixed": "mixed.mp4" },
          "note": "★ produces ⇒ 把产物路径交给后面的步骤（$film = <outDir>/film.mp4）"
        },
        {
          "verb": "audio_mix",
          "args": { "draft": "$dir", "video": "$film", "out": "$mixed" },
          "note": "★ 按草稿里的音频结构重做混音，归一到 −14 LUFS"
        }
      ]
    },
    {
      "id": "review-only",
      "when": "审这一版（'审一下这版' / '这版片子审得过吗' / '交片前检查一下'）",
      "requires": ["剪映在跑", "★ 审片【只读不改】：这条路线只开副本做体检，不改草稿、不落盘"],
      "steps": [
        { "verb": "draft_open", "args": { "draft": "$draft", "copy": true }, "yields": ["$sessionId", "$dir"] },
        { "verb": "draft_read", "args": { "sessionId": "$sessionId" } },
        {
          "verb": "render_frames",
          "args": { "draft": "$dir", "outDir": "$reviewDir" },
          "produces": { "$reviewDir": "review" },
          "note": "★ 第一次渲染 = 这一版的帧"
        },
        {
          "verb": "render_frames",
          "args": { "draft": "$dir", "outDir": "$noiseDir" },
          "produces": { "$noiseDir": "noise" },
          "note": "★ ★ 同一状态【再渲一次】⇒ 差异就是官方渲染器的噪声底（审片前最该先知道的数）"
        },
        {
          "verb": "make_film",
          "args": { "draft": "$dir", "outDir": "$outDir", "denoise": "auto" },
          "produces": { "$film": "film.mp4" },
          "note": "★ 出片（自带时长/响度验收）⇒ 成片路径交给下一步量响度"
        },
        {
          "verb": "verify_diff",
          "args": {
            "afterDir": "$reviewDir/frames",
            "noiseDir": "$noiseDir/frames",
            "afterVideo": "$film",
            "afterDraft": "$draftJson",
            "realDraft": "$draft",
            "checks": ["visibility", "picture", "audio", "timeline", "draft_integrity"]
          },
          "note": "★ 单版审片：没有改前 ⇒ visibility 判不了（会明说 skipped 并给出噪声底）、picture 只给绝对值不判失败；audio/timeline/draft_integrity 是这一版的真实体检"
        }
      ]
    },
    {
      "id": "review-compare",
      "when": "两版对照审片（'把改前改后对着看一遍' / '这版比上一版改了什么'）",
      "requires": ["剪映在跑", "★ 两份草稿：改前 $draft + 改后 $draftAfter", "★ 审片只读不改（不授权动草稿）"],
      "steps": [
        { "verb": "draft_open", "args": { "draft": "$draft", "copy": true },
          "setVars": { "$sidBefore": "$sessionId", "$dirBefore": "$dir" },
          "note": "★ 先把改前的会话/副本存下来（否则第二次开草稿会覆盖 $sessionId / $dir）" },
        { "verb": "draft_read", "args": { "sessionId": "$sidBefore" },
          "setVars": { "$beforeDraftJson": "$draftJson" } },
        { "verb": "draft_open", "args": { "draft": "$draftAfter", "copy": true },
          "setVars": { "$sidAfter": "$sessionId", "$dirAfter": "$dir" } },
        { "verb": "draft_read", "args": { "sessionId": "$sidAfter" },
          "setVars": { "$afterDraftJson": "$draftJson" } },
        { "verb": "render_frames", "args": { "draft": "$dirBefore", "outDir": "$reviewDir/before" },
          "produces": { "$reviewDir": "review" },
          "setVars": { "$beforeOut": "$outDir/before", "$afterOut": "$outDir/after" },
          "note": "★ 改前的帧；同时定下两版的成片输出目录（后面 make_film 用）" },
        { "verb": "render_frames", "args": { "draft": "$dirAfter", "outDir": "$reviewDir/after" } },
        { "verb": "render_frames", "args": { "draft": "$dirAfter", "outDir": "$reviewDir/noise" },
          "note": "★ ★ 同一状态【再渲一次】（改后那一版）⇒ 差异就是官方渲染器的噪声底" },
        { "verb": "make_film", "args": { "draft": "$dirBefore", "outDir": "$beforeOut" },
          "produces": { "$filmBefore": "before/film.mp4" },
          "note": "★ 改前的成片（音频维度要它）" },
        { "verb": "make_film", "args": { "draft": "$dirAfter", "outDir": "$afterOut" },
          "produces": { "$filmAfter": "after/film.mp4" },
          "note": "★ 改后的成片" },
        { "verb": "verify_diff",
          "args": {
            "beforeDir": "$reviewDir/before/frames",
            "afterDir": "$reviewDir/after/frames",
            "noiseDir": "$reviewDir/noise/frames",
            "beforeVideo": "$filmBefore",
            "afterVideo": "$filmAfter",
            "beforeDraft": "$beforeDraftJson",
            "afterDraft": "$afterDraftJson",
            "realDraft": "$draftAfter",
            "checks": ["visibility", "picture", "audio", "timeline", "draft_integrity"]
          },
          "note": "★ 两版对照：像素（带噪声底校准）+ 画质 + 响度 + 逐段字段差 + 真草稿 sha" }
      ]
    }
  ]
}
