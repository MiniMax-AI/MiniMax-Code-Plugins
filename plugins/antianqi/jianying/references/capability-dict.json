{
  "schema": "jianying.capability-dict.v1",
  "note": "46 项能力 → 动词 → 参数/op → 判据。机器可读版；人读版见 references/chain-api.md",
  "verbs": {
    "draft_open": {
      "kind": "official-semantics",
      "ops": [],
      "guards": [
        "默认开副本",
        "非副本需 allowReal"
      ]
    },
    "draft_read": {
      "kind": "official-semantics",
      "ops": [
        "full",
        "timeline",
        "segments",
        "materials"
      ],
      "guards": []
    },
    "draft_patch": {
      "kind": "official-semantics",
      "ops": [
        "draft.setCanvasSize",
        "draft.setDraftId",
        "track.add",
        "track.delete",
        "track.mute",
        "segment.move",
        "segment.scale",
        "segment.translate",
        "segment.rotate",
        "segment.updateLayout",
        "segment.split",
        "segment.delete",
        "segment.setTimeRange",
        "segment.innerReplace",
        "segment.setDescription",
        "video.add",
        "video.muteOn",
        "video.muteOff",
        "video.setVolume",
        "audio.add",
        "audio.setVolume",
        "text.add",
        "undoRedo.undo",
        "undoRedo.redo",
        "undoRedo.canUndo",
        "undoRedo.canRedo",
        "invokeBatch"
      ],
      "guards": [
        "改前必须先 draft_open",
        "★ 这 27 个官方 op 里【没有】设置调色/滤镜参数的 op（只有结构/音量/布局/文字/撤销重做）⇒ 调色参数改不进草稿，草稿侧字段名未确证；调色走 grade_apply 出片（见 node_kinds 与 references/chain-api.md）"
      ]
    },
    "draft_commit": {
      "kind": "official-semantics",
      "ops": [],
      "guards": [
        "素材路径重定位",
        "真草稿 sha 前后比对"
      ]
    },
    "render_frames": {
      "kind": "official-semantics",
      "ops": [],
      "guards": []
    },
    "grade_apply": {
      "kind": "ours",
      "ops": [
        "adjustColor",
        "colorCorrection",
        "curves",
        "hsl",
        "hsl_curves",
        "logWheel",
        "particle",
        "primaryWheel",
        "sharpen",
        "vignetting"
      ],
      "guards": [
        "未知键直接拒绝",
        "逐节点生效探针（节点为 0 ⇒ 失败）"
      ]
    },
    "audio_mix": {
      "kind": "ours",
      "ops": [],
      "guards": [
        "响度归一到 −14 LUFS"
      ]
    },
    "verify_diff": {
      "kind": "ours",
      "ops": [],
      "guards": [
        "max-over-frames（不抽单帧）",
        "真草稿 sha 断言"
      ]
    }
  },
  "capabilities": {
    "element": {
      "draft": "draft_read",
      "main": "draft_read",
      "multi": "draft_read"
    },
    "segment": {
      "video": "draft_patch#video.add",
      "image": "draft_patch",
      "text": "draft_patch",
      "subtitle": "draft_patch",
      "sound": "audio_mix",
      "sticker": "draft_patch"
    },
    "property": {
      "transform": "draft_patch",
      "time": "draft_patch",
      "alpha": "draft_patch",
      "content": "draft_patch",
      "sub": "draft_patch",
      "effect": "grade_apply#adjustColor|colorCorrection|hsl|logWheel|primaryWheel|curves|hsl_curves|sharpen|vignetting|particle",
      "mask": "draft_patch",
      "matting": "draft_patch",
      "animation": "draft_patch",
      "speed_curve": "draft_patch"
    }
  },
  "node_kinds": {
    "bakeable_3dlut": [
      "adjustColor",
      "colorCorrection",
      "curves",
      "hsl",
      "hsl_curves",
      "logWheel",
      "primaryWheel"
    ],
    "render_time": [
      "particle",
      "sharpen",
      "vignetting"
    ],
    "sub_param_of_adjustColor": [
      "fade",
      "lightSensation"
    ]
  },
  "acceptance": {
    "grade_apply": "每个节点单开必须产生非零改变（MAD>0）",
    "verify_diff": "画面维度：max MAD > max(threshold, noiseMad×1.5)，且必须给 noiseDir（同态重渲染的帧）做噪声校准；官方渲染器同态噪声底实测 MAD 48~123 ⇒ 未校准的裸 MAD 只能作参考。语义维度：用 expect 断言落盘草稿的逐段字段差（不依赖像素）",
    "draft_commit": "真草稿 sha 前后逐字节相同"
  }
}