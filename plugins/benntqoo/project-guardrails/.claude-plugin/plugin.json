{
  "name": "project-guardrails",
  "version": "1.0.0",
  "description": "Let a repository declare its own rules: project conventions and a todo-ledger index are injected at session start, and tool calls are checked against the repository's deny/ask rules before they run. Zero configuration when the repository has a ledger carrier.",
  "author": {
    "name": "benntqoo",
    "url": "https://github.com/benntqoo"
  },
  "homepage": "https://github.com/MiniMax-AI/MiniMax-Code-Plugins/tree/main/plugins/benntqoo/project-guardrails",
  "repository": "https://github.com/MiniMax-AI/MiniMax-Code-Plugins.git",
  "license": "MIT",
  "keywords": [
    "minimax-code",
    "hooks",
    "guardrails",
    "safety",
    "project-config"
  ],
  "skills": [
    "./skills/project-guardrails/SKILL.md"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${PLUGIN_ROOT}/io.minimax.mcode/hooks/scripts/session-rules.mjs"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${PLUGIN_ROOT}/io.minimax.mcode/hooks/scripts/session-entrypoints.mjs"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${PLUGIN_ROOT}/io.minimax.mcode/hooks/scripts/pretooluse-guard.mjs"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
