{
  "name": "memory-loop",
  "version": "1.0.0",
  "description": "Close the memory loop: a Stop hook collects memory candidates per project, a Skill distills them into MEMORY.md, and SessionStart injects that memory into every new conversation. Fully local and version-controlled with the repository.",
  "author": {
    "name": "benntqoo",
    "url": "https://github.com/benntqoo"
  },
  "homepage": "https://github.com/MiniMax-AI/MiniMax-Code-Plugins/tree/main/plugins/benntqoo/memory-loop",
  "repository": "https://github.com/MiniMax-AI/MiniMax-Code-Plugins.git",
  "license": "MIT",
  "keywords": [
    "minimax-code",
    "memory",
    "hooks",
    "context",
    "workflow"
  ],
  "skills": [
    "./skills/memory-loop/SKILL.md"
  ],
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${PLUGIN_ROOT}/io.minimax.mcode/hooks/scripts/collect-candidate.mjs"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${PLUGIN_ROOT}/io.minimax.mcode/hooks/scripts/recall-memory.mjs"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
